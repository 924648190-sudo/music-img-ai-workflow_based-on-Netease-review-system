# Required only for scripts/run_workflow.py, after publishing your app in Dify.
# Copy to .env locally. Never commit .env or paste actual keys into workflow YAML.
DIFY_API_BASE_URL=https://api.dify.ai/v1
DIFY_API_KEY=
DIFY_API_TIMEOUT=360

# The existing workflow uses Dify-managed DeepSeek provider credentials.
# They are NOT read from this .env by Dify; see docs/CONFIGURATION.md.
